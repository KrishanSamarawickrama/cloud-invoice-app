# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=InvoiceDb

# JWT Authentication
JWT_SECRET_KEY=changeme_generate_with_openssl_rand_base64_32

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS — comma-separated origins (leave empty if only accessed via Nginx proxy)
ALLOWED_ORIGINS=
