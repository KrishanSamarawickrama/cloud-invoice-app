# Docker Compose Environment Variables
# Copy this to .env and fill in with real values (do not commit .env)

# App image and port
APP_IMAGE=yourdockerhubuser/cloud-invoice-app:latest
APP_PORT=8080

# PostgreSQL
POSTGRES_PASSWORD=changeme
POSTGRES_USER=postgres
POSTGRES_DB=InvoiceDb

# JWT
JWT_SECRET_KEY=replace-with-at-least-32-char-random-secret
JWT_ISSUER=CloudInvoiceApp
JWT_AUDIENCE=CloudInvoiceApp
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Google OAuth (used by both frontend and backend)
# Frontend fetches this from /api/config endpoint at runtime
# Backend uses it to validate Google ID tokens
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# CORS (comma-separated origins, empty = allow all)
ALLOWED_ORIGINS=
