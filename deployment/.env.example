# ===========================================
# Domain
# ===========================================
DOMAIN=krishan.io
ACME_EMAIL=your-email@example.com

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=invoice_db

# ===========================================
# Backend
# ===========================================
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__invoice-db=Host=database;Port=5432;Database=invoice_db;Username=postgres;Password=change_me_to_a_strong_password

# JWT
Jwt__SecretKey=change_me_to_a_long_random_string_at_least_32_chars
Jwt__Issuer=CloudInvoiceApp
Jwt__Audience=CloudInvoiceApp

# Google OAuth
Google__ClientId=your_google_client_id
